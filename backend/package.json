{
  "name": "ai-shopping-assistant-backend",
  "version": "1.0.0",
  "description": "Express.js & Prisma backend for AI Shopping Assistant with Gemini API real-time streaming & PostgreSQL",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:start": "pg_ctl -D data/postgres -l data/postgres/server.log start",
    "db:stop": "pg_ctl -D data/postgres stop",
    "db:status": "pg_ctl -D data/postgres status",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio"
  },
  "keywords": [
    "gemini",
    "google-generative-ai",
    "nodejs",
    "express"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2"
  },
  "devDependencies": {
    "prisma": "^6.19.3"
  }
}
