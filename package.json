{
  "name": "ai-shopping-assistant",
  "version": "1.0.0",
  "description": "Full-stack AI Shopping Assistant powered by Google Gemini API with real-time streaming, search grounding, verified retailer links, and multi-turn context management.",
  "scripts": {
    "dev": "node start-dev.js",
    "start": "node start-dev.js",
    "start:backend": "cd backend && npm start",
    "dev:backend": "cd backend && npm run dev",
    "dev:frontend": "cd frontend && npm run dev",
    "build:frontend": "cd frontend && npm run build",
    "db:start": "cd backend && npm run db:start",
    "db:stop": "cd backend && npm run db:stop",
    "db:status": "cd backend && npm run db:status",
    "db:push": "cd backend && npm run db:push",
    "db:studio": "cd backend && npm run db:studio"
  },
  "keywords": [
    "gemini",
    "gemini-api",
    "react",
    "nodejs",
    "express"
  ],
